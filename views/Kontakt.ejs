<!DOCTYPE html>
<html lang="no">
  <head>
    <!-- Grunninfo for siden og lenke til stilarket. -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Kontakt Fjordvik IT-Hjelp for hjelp med IT-support, utstyr og digitale løsninger."
    />
    <title>Kontakt | Fjordvik IT-Hjelp</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="content-page contact-page">
    <!-- Viser menyen som brukes på alle sidene. -->
    <%- include("partials/navbar") %>

    <main>
      <!-- Introduserer kontaktsiden. -->
      <section class="content-hero" aria-labelledby="contact-title">
        <p class="services-eyebrow">Kontakt</p>
        <h1 id="contact-title">Vi hjelper deg videre.</h1>
        <p class="content-hero__intro">
          Har du spørsmål om IT-support, utstyr eller hvordan du kan få mer
          trygghet i hverdagen digitalt? Vi er klare til å hjelpe deg.
        </p>
      </section>

      <!-- Viser kontaktmåter og neste steg. -->
      <section class="contact-layout" aria-labelledby="contact-methods-title">
        <div class="contact-panel">
          <p class="services-eyebrow">Kontaktinformasjon</p>
          <h2 id="contact-methods-title">Ta kontakt</h2>
          <p>
            Send oss en melding, ring eller besøk oss for en uforpliktende prat
            om hva du trenger hjelp med.
          </p>

          <!-- Telefon, e-post, adresse og åpningstider. -->
          <div class="contact-methods">
            <div class="contact-method">
              <span class="contact-method__label">Åpningstider</span>
              <ul class="contact-hours">
                <li>Mandag–fredag: kl. 08:00–16:00</li>
                <li>Lørdag–søndag: Fri</li>
              </ul>
            </div>
            <a class="contact-method" href="tel:+4799999999">
              <span class="contact-method__label">Telefon</span>
              +47 99 99 99 99
            </a>
            <a class="contact-method" href="mailto:kontaktIT@fjordvik.no">
              <span class="contact-method__label">E-post</span>
              kontakt@fjordvikIT.no
            </a>
            <a
              class="contact-method"
              href="https://maps.google.com/?q=Fjordvik"
            >
              <span class="contact-method__label">Adresse</span>
              Fjordvik, Norge
            </a>
          </div>
        </div>

        <aside class="contact-help">
          <p class="services-eyebrow">Neste steg</p>
          <h2>Få hjelp uten stress.</h2>
          <p>
            Beskriv kort hva som ikke fungerer, og vi kan komme med et praktisk
            forslag til neste steg.
          </p>
          <a class="services-button" href="mailto:kontakt@fjordvik.no">
            Send e-post
          </a>
        </aside>
      </section>
    </main>
  </body>
</html>
