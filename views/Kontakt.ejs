<!DOCTYPE html>
<html lang="nb">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Kontakt Fjordvik IT-Hjelp for hjelp med PC, nettverk og andre IT-utfordringer."
    />
    <title>Kontakt | Fjordvik IT-Hjelp</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="content-page contact-page">
    <%- include("partials/navbar") %>

    <main>
      <section class="content-hero" aria-labelledby="contact-title">
        <p class="services-eyebrow">Kontakt oss</p>
        <h1 id="contact-title">Vi hjelper deg gjerne.</h1>
        <p class="content-hero__intro">
          Har du spørsmål eller trenger hjelp med IT? Ta kontakt, så finner vi
          ut av hva du trenger.
        </p>
      </section>

      <section class="contact-layout" aria-label="Kontaktinformasjon">
        <div class="contact-panel">
          <p class="services-eyebrow">Slik når du oss</p>
          <h2>Ta kontakt</h2>
          <p>
            Fortell oss kort hva du trenger hjelp med, så tar vi det derfra.
          </p>
          <div class="contact-methods">
            <a class="contact-method" href="mailto:exemple@gmail.com">
              <span class="contact-method__label">E-post</span>
              <span>exemple@gmail.com</span>
            </a>
            <a class="contact-method" href="tel:00000000">
              <span class="contact-method__label">Telefon</span>
              <span>00000000</span>
            </a>
          </div>
        </div>

        <aside class="contact-help">
          <h2>Hva kan vi hjelpe med?</h2>
          <p>
            Du kan ta kontakt om alt fra en treg PC til problemer med nettverk,
            utstyr eller sikkerhetskopiering.
          </p>
          <a class="services-button" href="/tjenester">Se alle tjenestene</a>
        </aside>
      </section>
    </main>
  </body>
</html>
